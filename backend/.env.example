# Any OpenAI-compatible API. The bill splitter needs a model that accepts images.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Supabase: Project Settings -> API. Use the secret / service_role key (server only, never in the frontend).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=

# Your Vercel URL(s), comma-separated. Use * only for local testing.
ALLOWED_ORIGINS=https://your-app.vercel.app
